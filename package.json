{
  "name": "oumouls-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm -w backend run start:prod",
    "dev:web": "npm -w web run dev",
    "dev:mobile": "npm -w mobile run start",
    "dev:backend": "npm -w backend run start:dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.4.2",
    "turbo": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "npx prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": "npx eslint --max-warnings=0"
  }
}
