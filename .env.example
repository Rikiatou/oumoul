# Shared environment variables
# Base URL for backend API consumed by web and mobile clients
OUMOUL_API_URL=http://localhost:3333

# Backend service configuration
PORT=3333
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oumoul
REDIS_URL=redis://localhost:6379
JWT_ACCESS_TOKEN_SECRET=change-me
JWT_REFRESH_TOKEN_SECRET=change-me-too

# Third-party integrations (fill as needed)
FCM_SERVER_KEY=
SENTRY_DSN=

# Web app (Next.js)
NEXT_PUBLIC_API_URL=${OUMOUL_API_URL}
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Mobile app (Expo)
EXPO_PUBLIC_API_URL=${OUMOUL_API_URL}
EXPO_PUBLIC_DEFAULT_LOCALE=fr

# Queue / Cache
REDIS_URL=redis://localhost:6379

# Payment providers
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
